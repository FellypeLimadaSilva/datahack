{
  "name": "DataHack — Data Engineering",
  "dockerComposeFile": ["../docker-compose.yml", "compose.devcontainer.yml"],
  "service": "devcontainer",
  "runServices": ["warehouse", "devcontainer"],
  "workspaceFolder": "/workspaces/datahack",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --user -e '.[dev,dbt]' && pre-commit install || true",
  "remoteEnv": {
    "DBT_PROFILES_DIR": "/workspaces/datahack/dbt",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "innoverio.vscode-dbt-power-user",
        "redhat.vscode-yaml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "eamodio.gitlens",
        "github.vscode-github-actions"
      ]
    }
  }
}
