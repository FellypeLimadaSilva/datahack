{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ingest: rodar fonte (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "datahack_ingest",
      "args": ["run", "${input:source}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Ingest: dry-run (perfilar sem gravar)",
      "type": "debugpy",
      "request": "launch",
      "module": "datahack_ingest",
      "args": ["run", "${input:source}", "--dry-run"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Pytest: arquivo atual",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "inputs": [
    { "id": "source", "type": "promptString", "description": "Nome da fonte", "default": "vendas" }
  ]
}
