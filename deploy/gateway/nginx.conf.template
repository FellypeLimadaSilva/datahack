# Porta única do sistema na Railway (único serviço com domínio público).
#   /            -> Superset   (SUPERSET_HOST:SUPERSET_PORT, rede privada)
#   /assistente/ -> chat       (CHAT_HOST:CHAT_PORT, rede privada)
# Variáveis em runtime: PORT, SUPERSET_HOST/PORT, CHAT_HOST/PORT, DNS_RESOLVER (DNS da rede privada da Railway).
resolver ${DNS_RESOLVER} valid=10s ipv6=on;

map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
# o TLS termina no edge da Railway: repassa o esquema original (o Superset gera URLs https e cookies Secure)
map $http_x_forwarded_proto $fwd_proto { default $http_x_forwarded_proto; '' $scheme; }

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    absolute_redirect off;
    client_max_body_size 64m;

    location = /gate/health { access_log off; return 200 "ok\n"; }

    location = / { return 302 /superset/dashboard/rota-do-diploma/; }

    location /assistente/ {
        set $chat_upstream http://${CHAT_HOST}:${CHAT_PORT};
        rewrite ^/assistente/(.*)$ /$1 break;
        proxy_pass $chat_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_buffering off;            # respostas do chat chegam em streaming (SSE)
        proxy_read_timeout 120s;
    }

    location / {
        set $superset_upstream http://${SUPERSET_HOST}:${SUPERSET_PORT};
        proxy_pass $superset_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 300s;
    }
}
