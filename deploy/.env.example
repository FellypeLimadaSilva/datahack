# Variáveis por serviço na Railway (Service > Variables). NADA disto vai para o Git.
# "${{Postgres.X}}" é a sintaxe de referência da Railway ao plugin Postgres do mesmo projeto.

# ── serviço: superset ─────────────────────────────────────────────
PORT=8088          # o healthcheck da Railway usa PORT; o gunicorn do init.sh ouve em 8088
RAILWAY_DOCKERFILE_PATH=deploy/superset.Dockerfile
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}
PGDATABASE=${{Postgres.PGDATABASE}}
WAREHOUSE_HOST=${{Postgres.PGHOST}}
WAREHOUSE_PORT=${{Postgres.PGPORT}}
WAREHOUSE_DB=datahack
WAREHOUSE_BI_USER=dh_bi_reader
WAREHOUSE_BI_PASSWORD=<senha-nova-para-o-papel-somente-leitura>
SUPERSET_DB_URI=postgresql+psycopg2://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/superset
SUPERSET_SECRET_KEY=<gere: openssl rand -base64 42>
SUPERSET_ADMIN_PASSWORD=<senha-do-admin-do-dashboard>
GUNICORN_WORKERS=2

# ── serviço: chatbot (monte um Volume em /data) ──────────────────
PORT=8099
RAILWAY_DOCKERFILE_PATH=deploy/chatbot.Dockerfile
RAILWAY_RUN_UID=0
WAREHOUSE_HOST=${{Postgres.PGHOST}}
WAREHOUSE_PORT=${{Postgres.PGPORT}}
WAREHOUSE_DB=datahack
WAREHOUSE_BI_USER=dh_bi_reader
WAREHOUSE_BI_PASSWORD=${{superset.WAREHOUSE_BI_PASSWORD}}
SUPERSET_URLS=http://superset.railway.internal:8088
CHAT_PARENT_ORIGINS=https://<dominio-publico-do-gateway>
CHAT_DAILY_CAP=500
# A chave da DeepSeek NÃO é variável: o admin cola em Settings > Configurações do chat (IA); fica no volume /data.

# ── serviço: gateway (o único com domínio público) ───────────────
PORT=8080
RAILWAY_DOCKERFILE_PATH=deploy/gateway.Dockerfile
SUPERSET_HOST=superset.railway.internal
SUPERSET_PORT=8088
CHAT_HOST=chatbot.railway.internal
CHAT_PORT=8099
