{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/gateway.Dockerfile",
    "watchPatterns": ["deploy/gateway/**", "deploy/gateway.Dockerfile"]
  },
  "deploy": {
    "healthcheckPath": "/gate/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
