{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/superset.Dockerfile",
    "watchPatterns": ["superset/**", "outputs/**", "deploy/superset/**", "deploy/superset.Dockerfile"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 900,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
