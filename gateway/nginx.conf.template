# Porta única do sistema: dashboard (Superset) e chat com IA saem pelo mesmo endereço.
#   /            -> Superset (abre direto no dashboard)
#   /assistente/ -> serviço do chat (iframe do botão "Pergunte aos dados" e aba Configurações)
upstream superset_app { server host.docker.internal:${SUPERSET_PORT}; keepalive 16; }
upstream chat_app     { server host.docker.internal:${CHAT_PORT};     keepalive 8; }

map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

server {
    listen 8088;
    server_name _;
    absolute_redirect off;
    client_max_body_size 64m;

    location = / { return 302 /superset/dashboard/rota-do-diploma/; }

    location /assistente/ {
        rewrite ^/assistente/(.*)$ /$1 break;
        proxy_pass http://chat_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;            # respostas do chat chegam em streaming (SSE)
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://superset_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
